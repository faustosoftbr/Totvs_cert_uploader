# Exemplo de variáveis de ambiente para o TOTVS Cert Uploader
# Copie este arquivo para .env e preencha com suas credenciais locais:
#   copy .env.example .env

# Credenciais do Portal TEC (Totvs Hospitalidade)
TEC_USER=
TEC_PASSWORD=

# Credenciais do Chef Web Cloud
CHEFWEB_USER=
CHEFWEB_PASSWORD=

# Credenciais do banco SQL Server local (MISTERCHEFNET)
SQL_USER=sa
SQL_PASSWORD=

# Google Apps Script Webhook para telemetria e envio de logs
GAS_WEBHOOK_URL=

# Plataforma Fiscal TPF (opcional / se aplicável)
TPF_USER=
TPF_PASSWORD=
